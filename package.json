{
  "name": "spurhund",
  "version": "0.1.0",
  "description": "Multi-engine research MCP server and Claude Agent SDK research worker (Exa + Brave)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "spurhund": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "verify": "tsc --noEmit && vitest run && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.300",
    "@modelcontextprotocol/server": "2.3.1",
    "better-sqlite3": "13.0.3",
    "exa-js": "2.25.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "SPEC.md"
  ]
}
